{
  "name": "simulador-fisica-2-3d",
  "version": "2.2.1",
  "private": true,
  "description": "Laboratorio interactivo de electricidad y magnetismo para Física II",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs --dist",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/physics.test.mjs tests/playback.test.mjs tests/experiments.test.mjs",
    "test:ui": "node scripts/qa.mjs",
    "format": "prettier --write src scripts tests index.html docs/*.js docs/*.css",
    "test:animations": "node scripts/animation-qa.mjs",
    "test:rendering": "node scripts/rendering-qa.mjs",
    "test:delivery": "node scripts/delivery-qa.mjs",
    "vendor:sync": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "test:static": "node scripts/static-qa.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
